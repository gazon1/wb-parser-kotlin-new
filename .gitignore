# Gradle
.gradle/
build/
# Kotlin compiler session files
.kotlin/

# Build output
*.class
*.jar
# gradle-wrapper.jar must be AFTER *.jar to take effect
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
*.war
*.ear
*.log

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Sensitive
.env
.env.*
!.env.example
secrets.yaml
credentials.json

# React build (generated at runtime, not committed)
web-frontend/node_modules/
web-frontend/dist/
web-frontend/.next/

# Kotlin
*.kt.bak
*.kts.bak
# The Kotlin Gradle plugin's per-project session directory — build state, not source.
.kotlin/

# Test output
hs_err_pid*.log
.zcode/plans/**

# Python bytecode from the gate scripts' unit tests
__pycache__/
*.pyc

# wb_catalog_targets.yaml is NOT ignored: it is the catalogue of crawl targets, and a
# deployment that cannot see which targets it is supposed to crawl cannot tell whether
# the crawl is complete. The file holds no credentials — only WB's public catalog ids,
# names, paths and search tokens (see scripts/wb-catalog/enrich_catalog_queries.py).

# Live WB browser session capture — holds a real `_wbauid` / `x_wbaas_token` cookie
# pair for a browser profile. It is a credential, not fixture data: a captured
# session grants storefront access as the logged-in profile.
scripts/wb_context.json

# Persistent browser profiles. They hold cookies and storage, and they live outside
# the repository on the machine that runs the crawler.
profiles/
.wbparser/
*.png

# Agent tooling directories, not project sources
agent/
.claude/
.zcode/skills/
skills-lock.json

# Measurement reports of the catalog length — a snapshot of one run, not a source.
# The numbers that belong in the repository live in wb_catalog_targets.yaml.
catalog_lengths.json

# Raw WB research captures. They hold cookies and profile identifiers, so a raw
# capture never enters the repository; sanitized evidence lives in
# devtools/wb-research/investigations/ and raw captures live in
# ~/.cache/wb-research/.
devtools/wb-research/local/
