# Required environment for the crawler. Copy to .env and fill in.
# Never commit a filled-in .env — only this example belongs in the repository.

# --- Database ---------------------------------------------------------------
# DB_NAME must match the database created by docker-compose.yml (wbparser) and the
# database the storefront reads. The legacy .NET stack used "webcrawler".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wbparser
DB_USER=postgres
DB_PASSWORD=

# --- Admin API --------------------------------------------------------------
# ADMIN_API_KEY is required — the admin API must not be reachable with a
# well-known credential. Generate one, e.g. `openssl rand -base64 32`.
ADMIN_API_KEY=

# ADMIN_PASSWORD is for Spring Boot Basic Auth (fallback); prefer X-Api-Key.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Browser (local Camoufox) ----------------------------------------------
# The browser runs on this machine, next to the crawler. Install the pinned build
# with `just browser::install` and check it with `just browser::verify`.
CAMOUFOX_HOME=
CAMOUFOX_BUILD=browsers/official/158.0.1-beta.41-3f2eb1d0
# Playwright launches the Camoufox binary; its own browsers are never used.
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# Where persistent browser profiles (cookies, storage) live.
PROFILES_DIR=

# --- Egress proxies ---------------------------------------------------------
# The proxy a browser profile leaves through. Credentials go here, never into the
# repository. SOCKS5 cannot carry credentials in Playwright; use CIDR-limited
# SOCKS5 or an HTTP proxy with Basic auth.
EGRESS_PROXY_HOST_SOCKS5=
EGRESS_PROXY_PORT_SOCKS5=
EGRESS_PROXY_HOST_HTTP=
EGRESS_PROXY_PORT_HTTP=
EGRESS_PROXY_USERNAME_HTTP=
EGRESS_PROXY_PASSWORD_HTTP=

# --- Optional ---------------------------------------------------------------
OTEL_ENDPOINT=http://localhost:4317