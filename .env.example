# Required environment for the crawler. Copy to .env and fill in.
# Never commit a filled-in .env — only this example belongs in the repository.

# --- Database ---------------------------------------------------------------
# DB_NAME must match the database created by docker-compose.yml (wbparser) and the
# database the storefront reads. The legacy .NET stack used "webcrawler".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wbparser
DB_USER=postgres
DB_PASSWORD=

# --- Admin API --------------------------------------------------------------
# ADMIN_API_KEY is required — the admin API must not be reachable with a
# well-known credential. Generate one, e.g. `openssl rand -base64 32`.
ADMIN_API_KEY=

# ADMIN_PASSWORD is for Spring Boot Basic Auth (fallback); prefer X-Api-Key.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Optional ---------------------------------------------------------------
OTEL_ENDPOINT=http://localhost:4317