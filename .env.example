# Required environment for the crawler. Copy to .env and fill in.
# Never commit a filled-in .env — only this example belongs in the repository.

# See docs/operations/credentials-runbook.md for how to generate and verify each
# value, and for the two traps that make a hand-written file fail at startup.

# --- Database ---------------------------------------------------------------
# DB_NAME must match the database created by docker-compose.yml (wbparser) and the
# database the storefront reads. The legacy .NET stack used "webcrawler".
# DB_PORT is 5433 for the local debug stack (the host side of its port mapping);
# a database reached directly is 5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=wbparser
DB_USER=postgres
DB_PASSWORD=

# The debug stack creates its superuser from these two, through docker-compose
# interpolation of CRAWLER_DATABASE_PASSWORD. DB_PASSWORD and
# CRAWLER_DATABASE_PASSWORD must agree, or the volume and the app disagree.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
CRAWLER_DATABASE_PASSWORD=

# --- Admin API --------------------------------------------------------------
# ADMIN_API_KEY is required — the admin API must not be reachable with a
# well-known credential. Generate one, e.g. `openssl rand -hex 32`.
ADMIN_API_KEY=

# ADMIN_PASSWORD is for Spring Boot Basic Auth (fallback); prefer X-Api-Key.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Catalog read API -------------------------------------------------------
# CATALOG_API_KEY is required for every profile except `once`: the application
# refuses to start without it. It MUST NOT contain ADMIN_API_KEY — the two are
# different consumers, and the application refuses a configuration that shares
# one key between them.
# CATALOG_DB_USER/CATALOG_DB_PASSWORD are the read-only role's own credentials,
# provisioned by db/roles/provision-catalog-readonly-role.sql.
CATALOG_API_KEY=
CATALOG_DB_USER=wb_catalog_ro
CATALOG_DB_PASSWORD=

# --- Browser (local Camoufox) ----------------------------------------------
# The browser runs on this machine, next to the crawler. Install the pinned build
# with `just browser::install` and check it with `just browser::verify`.
CAMOUFOX_HOME=
CAMOUFOX_BUILD=browsers/official/158.0.1-beta.41-3f2eb1d0
# Playwright launches the Camoufox binary; its own browsers are never used.
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# Where persistent browser profiles (cookies, storage) live.
PROFILES_DIR=

# --- Egress proxies ---------------------------------------------------------
# The proxy a browser profile leaves through. Credentials go here, never into the
# repository. SOCKS5 cannot carry credentials in Playwright; use CIDR-limited
# SOCKS5 or an HTTP proxy with Basic auth.
#
# These lines are commented out on purpose. An EMPTY value is not the same as an
# unset one: `EGRESS_PROXY_PORT_SOCKS5=` binds an empty string to an `int`, and
# Spring refuses to start with "A null value cannot be assigned to a primitive
# type". Leave them unset for a direct-only deployment, and uncomment the ones you
# actually fill in.
# EGRESS_PROXY_HOST_SOCKS5=
# EGRESS_PROXY_PORT_SOCKS5=
# EGRESS_PROXY_HOST_HTTP=
# EGRESS_PROXY_PORT_HTTP=
# EGRESS_PROXY_USERNAME_HTTP=
# EGRESS_PROXY_PASSWORD_HTTP=

# --- Optional ---------------------------------------------------------------
OTEL_ENDPOINT=http://localhost:4317